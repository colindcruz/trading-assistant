# Trading Assistant settings. Copy to .env (chmod 600). Read once at startup.
# Percentages are of the day's capital, read from Kite before the open.

# ---- Kite / Telegram (same Kite app and bot as pnl-monitor; the TA replaces it) ----
KITE_API_KEY=
ACCESS_TOKEN_PATH=/opt/pnl-monitor/.access_token
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Commands are accepted ONLY from this Telegram user id (send /status to @userinfobot to find it).
TELEGRAM_USER_ID=
# Optional phone push for URGENT alerts
NTFY_TOPIC=

# ---- Risk parameters (spec table; at Rs 20L these give -2L / -1L / -1.5L / +2.5L / +1.67L / +3.1L / 85k) ----
LOSS_LIMIT_PCT=10
LOSS_WARN1_PCT=5
LOSS_WARN2_PCT=7.5
LOCK_ARM_PCT=12.5
LOCK_FLOOR_PCT=8.33
TRAIL_START_PCT=15.6
TRAIL_DISTANCE_PCT=4.25
# Daily trade cap; 0 = no cap (decided 2026-10-31: the -2L loss limit ends the day instead).
MAX_TRADES=0
COOLDOWN_MINUTES=3
# Risk per trade, % of capital (Rs 50k at 20L).
RISK_PER_TRADE_PCT=2.5
# Floor drop per re-entry after a profit-lock exit, in rupees. Blank = risk per trade.
REENTRY_FLOOR_STEP=
FLOOR_ALERT_STEP=25000
# Morning capital read must be within this % of the last good value, else the last good value is used.
CAPITAL_SANITY_PCT=50
# >0 forces capital (testing, or if Kite margins are unavailable). 0 = read opening_balance from Kite.
CAPITAL_OVERRIDE=0

# ---- Exits ----
# Limit price = best bid * (1 - buffer). 5% is well inside the exchange LPP band (40% for premiums > Rs 50).
EXIT_BUFFER_PCT=5
REPRICE_ATTEMPTS=3
REPRICE_INTERVAL_SECONDS=2
URGENT_AFTER_SECONDS=30
# 0.2 s between orders = 5/s, under Kite's 10/s and SEBI's 10 OPS threshold.
ORDER_GAP_SECONDS=0.2
# MARKET fallback only (LIMIT is the primary path). -1 = Zerodha automatic protection. Required since 2026-04-01.
MARKET_PROTECTION=-1
# Positions with LTP below this are left alone by exit sweeps (0 = never skip). Alerts say what was skipped.
SKIP_BELOW_PRICE=0
# Exchange freeze quantities per order. NIFTY 3510 (54 lots of 65): NSE circular FAOP/76693, effective 2026-10-05.
# SENSEX 1000 (50 lots of 20): BSE single-order limit since 2023-12-04 (confirmed 2026-10-30). NSE revises these often.
FREEZE_QTY_NIFTY=3510
FREEZE_QTY_SENSEX=1000
CANCEL_WAIT_SECONDS=3

# ---- Charges (zerodha.com/charges, 2026-10-30; STT 0.15% since 2026-04-01) ----
CHARGE_STT_SELL_PCT=0.15
CHARGE_EXCH_NFO_PCT=0.03553
CHARGE_EXCH_BFO_PCT=0.0325
CHARGE_GST_PCT=18
CHARGE_BROKERAGE_PER_ORDER=20
CHARGE_STAMP_BUY_PCT=0.003
CHARGE_SEBI_PER_CRORE=10
# Fallback flat rate of turnover, from the October 2026 statement (Rs 11,700 per crore).
CHARGE_FLAT_RATE_PCT=0.117

# ---- Times (IST) ----
GUARDIAN_CHECK_TIME=09:00
PRE_OPEN_TIME=09:15
MARKET_OPEN_TIME=09:15
EXIT_ALL_TIME=15:06
NO_NEW_TIME=15:10
SUMMARY_TIME=15:30
MARKET_CLOSE_TIME=15:40

# ---- Infra ----
STATE_DIR=.
LOG_FILE=trading_assistant.log
HEARTBEAT_TIMEOUT_SECONDS=30
POSITIONS_POLL_SECONDS=2
TOKEN_CHECK_SECONDS=30
TELEGRAM_POLL_TIMEOUT=20

# ---- Near-the-money watchlist: live prices for contracts before you buy them (slippage measurement) ----
# Strikes each side of the money, calls and puts; 0 turns the watchlist off.
WATCH_STRIKES=10
WATCH_EXPIRIES=2
WATCH_REFRESH_SECONDS=60
